# Copy to .env.local for development. Never commit real values.

# ── Public (shipped to the browser) ─────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server only (never prefix with NEXT_PUBLIC_) ────────────────
# Secret key (sb_secret_...) or the legacy service_role key. Bypasses RLS.
SUPABASE_SECRET_KEY=
# Random 32+ characters, used to hash national IDs and IPs in login_attempts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_PEPPER=
